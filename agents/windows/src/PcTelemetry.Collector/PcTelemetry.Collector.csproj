<Project Sdk="Microsoft.NET.Sdk">

  <!-- S1-02b: LHM에 의존하지 않는 수집 핵심(센서 매핑·1초 루프·부팅 세션·이벤트·불변 배치). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PcTelemetry.Collector.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- S2-01 버퍼. 10.0.0은 취약한 SQLitePCLRaw 2.1.11(GHSA-2m69-gcr7-jv3q)을 끌어와 10.0.15(2.1.13)로 고정한다. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="[10.0.15]" />
  </ItemGroup>

</Project>
