TELEMETRY_REVISION=replace-with-build-revision
TELEMETRY_DOMAIN=telemetry.example.net
TELEMETRY_BIND_IP=0.0.0.0
TELEMETRY_MODELS=/srv/telemetry/models
TELEMETRY_ADMIN_PASSWORD_FILE=/etc/telemetry/secrets/admin-password
TELEMETRY_APP_PGPASS_FILE=/etc/telemetry/secrets/app.pgpass
TELEMETRY_BOOTSTRAP_PGPASS_FILE=/etc/telemetry/secrets/bootstrap.pgpass
