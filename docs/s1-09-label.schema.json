{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pc-telemetry:s1-09-label-v0.1-draft",
  "title": "S1-09 load transition session label (draft)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "label_schema_version",
    "session_id",
    "machine_alias",
    "machine_id",
    "boot_session_id",
    "environment",
    "sensor_config_id",
    "sensors",
    "safety_limits",
    "status",
    "run_started_at_utc",
    "run_ended_at_utc",
    "operator_alias",
    "stages",
    "transitions",
    "stop_reason",
    "artifacts"
  ],
  "properties": {
    "label_schema_version": { "const": "s1-09-label-v0.1-draft" },
    "session_id": { "$ref": "#/$defs/uuid" },
    "machine_alias": { "type": "string", "pattern": "^PC-[A-Z0-9]{1,8}$" },
    "machine_id": { "$ref": "#/$defs/uuid" },
    "boot_session_id": { "$ref": "#/$defs/uuid" },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu_model", "gpu_model", "os_build", "agent_version", "agent_commit"],
      "properties": {
        "cpu_model": { "type": "string", "minLength": 1 },
        "gpu_model": { "type": "string", "minLength": 1 },
        "os_build": { "type": "string", "minLength": 1 },
        "agent_version": { "type": "string", "minLength": 1 },
        "agent_commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
        "load_tool": { "type": ["string", "null"] },
        "load_tool_version": { "type": ["string", "null"] }
      }
    },
    "sensor_config_id": { "$ref": "#/$defs/uuid" },
    "sensors": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/sensor" }
    },
    "safety_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu_manufacturer_limit_celsius", "cpu_stop_threshold_celsius", "gpu_manufacturer_limit_celsius", "gpu_stop_threshold_celsius", "cpu_source", "gpu_source"],
      "properties": {
        "cpu_manufacturer_limit_celsius": { "type": "number", "exclusiveMinimum": 0 },
        "cpu_stop_threshold_celsius": { "type": "number", "exclusiveMinimum": 0, "description": "Must be below the recorded manufacturer limit; verify in the runbook." },
        "gpu_manufacturer_limit_celsius": { "type": "number", "exclusiveMinimum": 0 },
        "gpu_stop_threshold_celsius": { "type": "number", "exclusiveMinimum": 0, "description": "Must be below the recorded manufacturer limit; verify in the runbook." },
        "cpu_source": { "type": "string", "format": "uri" },
        "gpu_source": { "type": "string", "format": "uri" }
      }
    },
    "status": { "enum": ["completed", "aborted"] },
    "run_started_at_utc": { "$ref": "#/$defs/utcTimestamp" },
    "run_ended_at_utc": { "$ref": "#/$defs/utcTimestamp" },
    "operator_alias": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,32}$" },
    "reviewer_alias": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9_-]{1,32}$" },
    "stages": {
      "type": "array",
      "prefixItems": [
        { "$ref": "#/$defs/idleStage" },
        { "$ref": "#/$defs/cpuLoadStage" },
        { "$ref": "#/$defs/cpuCooldownStage" },
        { "$ref": "#/$defs/gpuLoadStage" },
        { "$ref": "#/$defs/gpuCooldownStage" }
      ],
      "items": false,
      "minItems": 5,
      "maxItems": 5
    },
    "transitions": {
      "type": "array",
      "prefixItems": [
        { "$ref": "#/$defs/idleToCpuTransition" },
        { "$ref": "#/$defs/cpuToCooldownTransition" },
        { "$ref": "#/$defs/cooldownToGpuTransition" },
        { "$ref": "#/$defs/gpuToCooldownTransition" }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "stop_reason": { "enum": ["none", "temperature_limit", "sensor_error", "agent_error", "device_instability", "operator_request", "other"] },
    "stop_details": { "type": ["string", "null"], "maxLength": 500 },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "sha256"],
        "properties": {
          "kind": { "enum": ["sanitized_label", "telemetry_export", "run_log"] },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "restricted_uri": { "type": ["string", "null"] }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "completed" } }, "required": ["status"] },
      "then": {
        "properties": {
          "stop_reason": { "const": "none" },
          "stages": { "items": { "properties": { "stage_status": { "const": "completed" } } } },
          "transitions": { "items": { "properties": { "transition_status": { "const": "observed" } } } }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "aborted" } }, "required": ["status"] },
      "then": { "properties": { "stop_reason": { "enum": ["temperature_limit", "sensor_error", "agent_error", "device_instability", "operator_request", "other"] } } }
    }
  ],
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "utcTimestamp": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "fan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "target_percent"],
      "properties": {
        "mode": { "enum": ["auto", "fixed", "unknown"] },
        "target_percent": { "type": ["number", "null"], "minimum": 0, "maximum": 100 }
      }
    },
    "sensor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sensor_id", "kind", "unit", "support", "last_quality"],
      "properties": {
        "sensor_id": { "type": "string", "pattern": "^[a-z0-9._/-]{1,128}$" },
        "kind": { "enum": ["temperature", "power", "utilization", "clock", "fan"] },
        "unit": { "enum": ["Cel", "W", "%", "MHz", "rpm"] },
        "support": { "enum": ["supported", "unsupported", "unobserved"] },
        "last_quality": { "enum": ["ok", "unsupported", "missing", "error", null] }
      }
    },
    "baseStage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage_id", "task", "target", "planned_minutes", "stage_status", "start_utc", "end_utc", "fan", "workload_tool", "workload_version", "workload_profile"],
      "properties": {
        "stage_id": { "type": "string" },
        "task": { "type": "string" },
        "target": { "enum": ["none", "cpu", "gpu"] },
        "planned_minutes": { "const": 10 },
        "stage_status": { "enum": ["completed", "aborted", "not_started"] },
        "start_utc": { "anyOf": [{ "$ref": "#/$defs/utcTimestamp" }, { "type": "null" }] },
        "end_utc": { "anyOf": [{ "$ref": "#/$defs/utcTimestamp" }, { "type": "null" }] },
        "fan": { "$ref": "#/$defs/fan" },
        "workload_tool": { "type": ["string", "null"] },
        "workload_version": { "type": ["string", "null"] },
        "workload_profile": { "type": ["string", "null"] }
      },
      "allOf": [
        {
          "if": { "properties": { "stage_status": { "const": "not_started" } }, "required": ["stage_status"] },
          "then": { "properties": { "start_utc": { "type": "null" }, "end_utc": { "type": "null" } } }
        },
        {
          "if": { "properties": { "stage_status": { "enum": ["completed", "aborted"] } }, "required": ["stage_status"] },
          "then": { "properties": { "start_utc": { "$ref": "#/$defs/utcTimestamp" }, "end_utc": { "$ref": "#/$defs/utcTimestamp" } } }
        }
      ]
    },
    "idleStage": {
      "allOf": [
        { "$ref": "#/$defs/baseStage" },
        { "properties": { "stage_id": { "const": "idle" }, "task": { "const": "idle" }, "target": { "const": "none" }, "workload_tool": { "type": "null" }, "workload_version": { "type": "null" }, "workload_profile": { "type": "null" } } }
      ]
    },
    "cpuLoadStage": {
      "allOf": [
        { "$ref": "#/$defs/baseStage" },
        { "properties": { "stage_id": { "const": "cpu_load" }, "task": { "const": "cpu_load" }, "target": { "const": "cpu" } } },
        { "if": { "properties": { "stage_status": { "enum": ["completed", "aborted"] } }, "required": ["stage_status"] }, "then": { "properties": { "workload_tool": { "type": "string", "minLength": 1 }, "workload_version": { "type": "string", "minLength": 1 }, "workload_profile": { "type": "string", "minLength": 1 } } } }
      ]
    },
    "cpuCooldownStage": {
      "allOf": [
        { "$ref": "#/$defs/baseStage" },
        { "properties": { "stage_id": { "const": "cpu_cooldown" }, "task": { "const": "cooldown" }, "target": { "const": "none" }, "workload_tool": { "type": "null" }, "workload_version": { "type": "null" }, "workload_profile": { "type": "null" } } }
      ]
    },
    "gpuLoadStage": {
      "allOf": [
        { "$ref": "#/$defs/baseStage" },
        { "properties": { "stage_id": { "const": "gpu_load" }, "task": { "const": "gpu_load" }, "target": { "const": "gpu" } } },
        { "if": { "properties": { "stage_status": { "enum": ["completed", "aborted"] } }, "required": ["stage_status"] }, "then": { "properties": { "workload_tool": { "type": "string", "minLength": 1 }, "workload_version": { "type": "string", "minLength": 1 }, "workload_profile": { "type": "string", "minLength": 1 } } } }
      ]
    },
    "gpuCooldownStage": {
      "allOf": [
        { "$ref": "#/$defs/baseStage" },
        { "properties": { "stage_id": { "const": "gpu_cooldown" }, "task": { "const": "cooldown" }, "target": { "const": "none" }, "workload_tool": { "type": "null" }, "workload_version": { "type": "null" }, "workload_profile": { "type": "null" } } }
      ]
    },
    "transitionBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transition_id", "from_stage", "to_stage", "target", "transition_status", "transition_at_utc", "validation", "exclusion_reason"],
      "properties": {
        "transition_id": { "$ref": "#/$defs/uuid" },
        "from_stage": { "type": "string" },
        "to_stage": { "type": "string" },
        "target": { "enum": ["cpu", "gpu"] },
        "transition_status": { "enum": ["observed", "not_observed"] },
        "transition_at_utc": { "anyOf": [{ "$ref": "#/$defs/utcTimestamp" }, { "type": "null" }] },
        "validation": { "enum": ["pending", "valid", "excluded", "not_applicable"] },
        "exclusion_reason": { "type": ["string", "null"], "maxLength": 200 }
      },
      "allOf": [
        {
          "if": { "properties": { "transition_status": { "const": "not_observed" } }, "required": ["transition_status"] },
          "then": { "properties": { "transition_at_utc": { "type": "null" }, "validation": { "const": "not_applicable" } } }
        },
        {
          "if": { "properties": { "transition_status": { "const": "observed" } }, "required": ["transition_status"] },
          "then": { "properties": { "transition_at_utc": { "$ref": "#/$defs/utcTimestamp" }, "validation": { "enum": ["pending", "valid", "excluded"] } } }
        }
      ]
    },
    "idleToCpuTransition": { "allOf": [{ "$ref": "#/$defs/transitionBase" }, { "properties": { "from_stage": { "const": "idle" }, "to_stage": { "const": "cpu_load" }, "target": { "const": "cpu" } } }] },
    "cpuToCooldownTransition": { "allOf": [{ "$ref": "#/$defs/transitionBase" }, { "properties": { "from_stage": { "const": "cpu_load" }, "to_stage": { "const": "cpu_cooldown" }, "target": { "const": "cpu" } } }] },
    "cooldownToGpuTransition": { "allOf": [{ "$ref": "#/$defs/transitionBase" }, { "properties": { "from_stage": { "const": "cpu_cooldown" }, "to_stage": { "const": "gpu_load" }, "target": { "const": "gpu" } } }] },
    "gpuToCooldownTransition": { "allOf": [{ "$ref": "#/$defs/transitionBase" }, { "properties": { "from_stage": { "const": "gpu_load" }, "to_stage": { "const": "gpu_cooldown" }, "target": { "const": "gpu" } } }] }
  }
}
